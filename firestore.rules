rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userRecordExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isPlatformAdmin() {
      return userRecordExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platform_role == 'Admin';
    }

    function brandRole(brandId) {
      return userRecordExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.brand_roles.get(brandId, '')
        : '';
    }

    function canReviewBrand(brandId) {
      return isPlatformAdmin() || brandRole(brandId) in ['Brand manager', 'Reviewer'];
    }

    // Role records are provisioned by a trusted administrator, never by clients.
    match /users/{uid} {
      allow read, write: if false;
    }

    // The Flask backend uses the Admin SDK for brand-scoped data. Direct browser
    // access is denied so changing a brand ID cannot bypass backend membership.
    match /brands/{brandId} {
      allow read, write: if false;
      match /{nestedCollection}/{documentId} {
        allow read, write: if false;
      }
    }

    match /scans/{scanId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['Pending', 'In review']
        && (
          !('brand_id' in request.resource.data)
          || brandRole(request.resource.data.brand_id) != ''
          || isPlatformAdmin()
        );
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status in ['Pending', 'In review']
          || (
            request.resource.data.status in ['Approved', 'Rejected']
            && 'brand_id' in request.resource.data
            && canReviewBrand(request.resource.data.brand_id)
          )
          || isPlatformAdmin()
        );
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      // Append-only from the browser: clients cannot rewrite history or erase it.
      allow update, delete: if false;
    }

    match /companyProfiles/{uid} {
      allow read: if isSelf(uid) && resource.data.uid == request.auth.uid;
      allow create: if isSelf(uid) && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Deny every collection not explicitly opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
