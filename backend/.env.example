# Never commit real credentials. Set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON path.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIRESTORE_DATABASE_ID=axionai
GEMINI_API_KEY=replace_me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Semantic evidence retrieval; set false to use hybrid lexical/concept retrieval only.
ENABLE_SEMANTIC_RETRIEVAL=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
